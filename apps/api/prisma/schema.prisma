generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  bike
  auto
  cab
}

/// Purely cosmetic live-map marker skin a driver can pick for themselves -
/// the vehicle icon shown inside a marker always still reflects VehicleType
/// regardless of this setting (see premium-map.tsx's liveDotHtml).
enum MarkerStyle {
  classic
  arrow
  beacon
  compact
}

enum RideStatus {
  requested
  matched
  arriving
  arrived
  in_progress
  completed
  cancelled
}

enum DriverVerificationStatus {
  pending
  verified
  rejected
}

enum KycDocType {
  license
  rc
  insurance
  profile_photo
}

enum KycStatus {
  not_uploaded
  pending_review
  verified
  rejected
}

enum PaymentMethodType {
  upi
  card
  cash
}

enum SavedPlaceLabel {
  home
  work
  other
}

enum WalletTxnType {
  credit
  debit
}

enum WalletTxnCategory {
  ride
  top_up
  refund
  payout
  bonus
  cancellation_fee
}

enum PayoutStatus {
  processed
  pending
  failed
}

enum OtpPurpose {
  customer
  driver
}

enum OwnerRole {
  customer
  driver
  admin
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum AdminActionTarget {
  driver
  customer
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  name          String   @default("")
  email         String?
  rating        Float    @default(5)
  walletBalance Int      @default(0)
  suspended     Boolean  @default(false)
  createdAt     DateTime @default(now())

  rides          Ride[]
  savedPlaces    SavedPlace[]
  paymentMethods PaymentMethod[]
  walletTxns     WalletTransaction[]
}

model Driver {
  id                 String                   @id @default(cuid())
  phone              String                   @unique
  name               String                   @default("")
  rating             Float                    @default(5)
  totalRides         Int                      @default(0)
  vehicleType        VehicleType              @default(bike)
  make               String                   @default("")
  model              String                   @default("")
  registrationNumber String                   @default("")
  color              String                   @default("")
  markerStyle        MarkerStyle              @default(classic)
  verificationStatus DriverVerificationStatus @default(pending)
  isOnline           Boolean                  @default(false)
  onlineSince        DateTime?
  suspended          Boolean                  @default(false)
  lat                Float
  lng                Float
  createdAt          DateTime                 @default(now())

  /// Set whenever lat/lng is written (signup seed, or POST /driver/location).
  /// Used by the matching engine to exclude drivers whose location has gone
  /// stale (no ping within LOCATION_STALE_MS) from candidate discovery.
  locationUpdatedAt DateTime?

  /// Generated from lat/lng by Postgres (see migration) via the earthdistance
  /// extension's ll_to_earth(); GiST-indexed for radius/nearest-neighbor
  /// queries. Never read or written directly through Prisma - lat/lng remain
  /// the source of truth, this column is maintained by Postgres automatically.
  ///
  /// CAUTION: Prisma cannot express GENERATED ALWAYS AS or the GiST index on
  /// an Unsupported field, so `prisma migrate dev` will perpetually see this
  /// column/index as drift and offer to "fix" it with a migration that drops
  /// the GiST index and un-generates the column - do NOT accept that
  /// migration. Use `prisma migrate dev --create-only` for future schema
  /// changes and manually strip any DROP INDEX "Driver_geo_idx" / ALTER
  /// COLUMN "geo" DROP DEFAULT lines from the generated SQL before applying.
  geo Unsupported("earth")?

  // Matching-engine signals: acceptance rate and idle time, alongside distance and rating.
  offeredCount    Int       @default(0)
  acceptedCount   Int       @default(0)
  lastRideEndedAt DateTime?

  kycDocuments KycDocument[]
  rides        Ride[]
  payouts      PayoutRecord[]
  earnings     DriverEarning[]

  @@index([isOnline, verificationStatus, suspended, vehicleType])
}

model KycDocument {
  id         String     @id @default(cuid())
  driverId   String
  driver     Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type       KycDocType
  label      String
  status     KycStatus  @default(not_uploaded)
  fileName   String?
  uploadedAt DateTime?

  @@index([driverId])
}

model Ride {
  id     String     @id @default(cuid())
  status RideStatus @default(requested)

  vehicleType   VehicleType
  pickupAddress String
  pickupLat     Float
  pickupLng     Float
  dropAddress   String
  dropLat       Float
  dropLng       Float

  riderId  String
  rider    User    @relation(fields: [riderId], references: [id])
  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  otp String

  fareBase          Int
  fareDistance      Int
  fareTime          Int
  fareSurge         Int @default(0)
  farePromoDiscount Int @default(0)
  fareTotal         Int

  distanceKm  Float
  durationMin Int

  requestedAt       DateTime  @default(now())
  offerExpiresAt    DateTime?
  excludedDriverIds String[]  @default([])

  acceptedAt   DateTime?
  /// Consecutive location pings received while "arriving" that were both
  /// GPS-accuracy-trustworthy and within ARRIVAL_RADIUS_METERS of pickup - a
  /// single noisy fix no longer commits "arrived" on its own (see
  /// driverRide.routes.ts's POST /location). Reset to 0 on a trustworthy
  /// out-of-radius ping; an untrustworthy (poor-accuracy) ping neither
  /// increments nor resets it.
  arrivalConfirmations Int @default(0)
  arrivedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  cancelledBy  OwnerRole?

  /// Set to 'paid' or 'failed' exactly once, when the ride is completed (see the
  /// driver's /rides/:rideId/end handler). Stays 'pending' for rides that never
  /// reach completion (still in flight, or cancelled).
  paymentStatus PaymentStatus @default(pending)

  rating Int?
  tip    Int?

  statusHistory      RideStatusHistory[]
  walletTransactions WalletTransaction[]
  driverEarning      DriverEarning?
  messages           RideMessage[]
  sosAlerts          SosAlert[]

  @@index([riderId])
  @@index([driverId])
  @@index([status])
}

/// In-ride chat between the rider and the assigned driver. Deliberately minimal -
/// plain text only, no attachments/read-receipts. senderRole is constrained to
/// "customer" | "driver" in application code (reuses OwnerRole since it already
/// has both variants - "admin" is never written here).
model RideMessage {
  id         String    @id @default(cuid())
  rideId     String
  ride       Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  senderRole OwnerRole
  body       String
  createdAt  DateTime  @default(now())

  @@index([rideId, createdAt])
}

/// An in-app emergency alert raised by the rider or driver during an active ride.
/// This is NOT integrated with any real emergency-service/dispatch API - it only
/// records the event and notifies TRYLO admins (see lib/notify.ts). riderId/driverId
/// are denormalized from the ride at alert time so an alert stays queryable even if
/// the ride reference is ever removed.
model SosAlert {
  id          String    @id @default(cuid())
  rideId      String
  ride        Ride      @relation(fields: [rideId], references: [id], onDelete: Cascade)
  triggeredBy OwnerRole
  riderId     String
  driverId    String?
  lat         Float?
  lng         Float?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([rideId])
  @@index([createdAt])
}

model RideStatusHistory {
  id        String     @id @default(cuid())
  rideId    String
  ride      Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)
  status    RideStatus
  note      String?
  createdAt DateTime   @default(now())

  @@index([rideId])
}

model SavedPlace {
  id      String          @id @default(cuid())
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  label   SavedPlaceLabel
  name    String
  address String
  lat     Float
  lng     Float

  @@index([userId])
}

model PaymentMethod {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PaymentMethodType
  label     String
  detail    String
  isDefault Boolean           @default(false)

  @@index([userId])
}

model WalletTransaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        WalletTxnType
  category    WalletTxnCategory
  amount      Int
  description String
  createdAt   DateTime          @default(now())

  /// Set only for category = 'ride' debits. Unique so the ride-completion debit
  /// can never be recorded twice for the same ride, even under a concurrent retry.
  rideId String? @unique
  ride   Ride?   @relation(fields: [rideId], references: [id])

  @@index([userId])
}

/// One row per ride whose payment succeeded — the source of truth for driver
/// earnings. rideId is unique so a ride can only ever produce one earning record,
/// even under a concurrent duplicate /rides/:rideId/end call.
model DriverEarning {
  id        String   @id @default(cuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rideId    String   @unique
  ride      Ride     @relation(fields: [rideId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@index([driverId])
}

model PayoutRecord {
  id               String       @id @default(cuid())
  driverId         String
  driver           Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount           Int
  status           PayoutStatus @default(processed)
  bankAccountLast4 String
  initiatedAt      DateTime     @default(now())
  processedAt      DateTime?

  @@index([driverId])
}

model OtpChallenge {
  id        String     @id @default(cuid())
  phone     String
  purpose   OtpPurpose
  code      String
  expiresAt DateTime
  consumed  Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

/// Refresh-token session, one row per logged-in device. The access token itself is
/// never stored (it's a short-lived stateless JWT); only the refresh token is
/// persisted, and only as a hash, so a DB read never exposes a usable token.
model Session {
  id               String    @id @default(cuid())
  ownerId          String
  ownerRole        OwnerRole
  refreshTokenHash String    @unique
  userAgent        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([ownerId, ownerRole])
}

model Notification {
  id        String    @id @default(cuid())
  ownerId   String
  ownerRole OwnerRole
  title     String
  body      String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([ownerId, ownerRole, read])
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  maxDiscount     Int?
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  actions AdminActionLog[]
}

/// Generic audit trail for admin mutations (driver approve/reject/suspend,
/// customer suspend, etc.) — one row per action, targetId is a free-form
/// reference into whichever table targetType names (no formal FK, since a
/// single relation can't point at two different target tables).
model AdminActionLog {
  id         String            @id @default(cuid())
  adminId    String
  admin      Admin             @relation(fields: [adminId], references: [id])
  action     String
  targetType AdminActionTarget
  targetId   String
  note       String?
  createdAt  DateTime          @default(now())

  @@index([targetType, targetId])
  @@index([adminId])
}
