{
  "routes": [
    { "route": "/customers/*", "rewrite": "/customers/placeholder.html" },
    { "route": "/drivers/*", "rewrite": "/drivers/placeholder.html" },
    { "route": "/rides/*", "rewrite": "/rides/placeholder.html" }
  ],
